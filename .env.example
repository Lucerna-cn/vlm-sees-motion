# AutoDL server credentials for scripts/server.py and scripts/check_server.py
# Copy this file to .env or set these as environment variables.
# The scripts read them with os.environ (load with python-dotenv if you use .env).
# 服务器凭据请填写你自己的 AutoDL 实例信息，切勿提交真实密码。
AUTODL_HOST=your-autodl-instance.example.com
AUTODL_PORT=22
AUTODL_USERNAME=root
AUTODL_PASSWORD=
